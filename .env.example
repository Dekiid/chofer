# Copia este ficheiro para .env.local e põe o teu token do Mapbox.
# O .env.local não vai para o GitHub.

# Rotas pelas estradas (Mapbox Directions API): o teu token público do Mapbox, começa por pk.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Alternativa, não usada: rotas do Google (Routes API).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapa do Android nas versões instaladas (Maps SDK for Android). Pode ser a mesma chave.
GOOGLE_MAPS_ANDROID_API_KEY=

# Supabase (o mesmo projeto dos pagamentos): liga o cliente ao motorista em tempo real.
# Sem estas duas linhas, a app fica em modo de demonstração (motorista e pedidos simulados).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
