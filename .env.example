# Copia este ficheiro para .env.local e põe a tua chave da Google Maps Platform.
# O .env.local não vai para o GitHub.

# Rotas pelas estradas (Routes API): km, tempo com trânsito e o desenho da rota.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapa do Android nas versões instaladas (Maps SDK for Android). Pode ser a mesma chave.
GOOGLE_MAPS_ANDROID_API_KEY=
